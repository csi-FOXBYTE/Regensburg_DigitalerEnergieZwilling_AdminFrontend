{
  "description": "Static Vite and React administration frontend for the Regensburg digital energy twin.",
  "buildDependencies": [
    "@tanstack/router-plugin",
    "@vitejs/plugin-react",
    "babel-plugin-react-compiler",
    "vite"
  ],
  "additionalComponents": [
    {
      "type": "container",
      "bom-ref": "oci:node:22-alpine",
      "name": "node",
      "version": "22-alpine (not digest pinned)",
      "scope": "required",
      "ecosystem": "OCI container",
      "relationship": "referenced build software",
      "metadataSource": "Dockerfile",
      "notes": "Builder base image; packages inside the image are not expanded.",
      "licenses": [
        {
          "license": {
            "name": "MIT (Node.js); container includes additional licenses"
          }
        }
      ]
    },
    {
      "type": "application",
      "bom-ref": "pkg:npm/pnpm@11.1.3",
      "name": "pnpm",
      "version": "11.1.3",
      "scope": "required",
      "ecosystem": "npm CLI",
      "relationship": "referenced build software",
      "metadataSource": "package.json and Dockerfile",
      "notes": "Package manager pinned by packageManager and enabled through Corepack for the container build.",
      "licenses": [
        {
          "license": {
            "id": "MIT"
          }
        }
      ]
    },
    {
      "type": "container",
      "bom-ref": "oci:nginxinc/nginx-unprivileged:alpine",
      "name": "nginxinc/nginx-unprivileged",
      "version": "alpine (not digest pinned)",
      "scope": "required",
      "ecosystem": "OCI container",
      "relationship": "referenced runtime software",
      "metadataSource": "Dockerfile",
      "notes": "Production image serving the generated static site; packages inside the image are not expanded.",
      "licenses": [
        {
          "license": {
            "name": "BSD-2-Clause (NGINX); container includes additional licenses"
          }
        }
      ]
    }
  ]
}

